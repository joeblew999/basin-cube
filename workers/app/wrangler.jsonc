{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "basin-cube",   // = APP_NAME in mise.toml
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // The UI, built into ui/dist by `mise run app:build`. API paths always reach the Worker.
  "assets": {
    "directory": "./ui/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/cubejs-api/*", "/mcp", "/mcp/*"]
  },

  // Demo data only: any caller can pick a tenant with the x-organisation-id header.
  "d1_databases": [
    { "binding": "DB", "database_name": "basin-cube", "database_id": "089ced40-23ff-4d2a-a571-6b3e4504cade", "migrations_dir": "migrations" }
  ]
}
