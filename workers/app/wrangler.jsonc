{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "d1-cube-check",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // The UI, built into ui/dist by `mise run app:build`. API paths always reach the Worker.
  "assets": {
    "directory": "./ui/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/cubejs-api/*", "/mcp", "/mcp/*"]
  },

  // Demo data only: any caller can pick a tenant with the x-organisation-id header.
  "d1_databases": [
    { "binding": "DB", "database_name": "d1-cube-check", "database_id": "b4179c65-d75b-4b1c-a0d6-7b13bbe42d30", "migrations_dir": "migrations" }
  ]
}
