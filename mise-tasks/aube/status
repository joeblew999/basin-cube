#!/usr/bin/env bash
#MISE description="aube's paths, store check, real disk use (compare df's free space: du counts APFS clones in full), and what aube:clean would remove"
#MISE timeout="2m"
#MISE hide=true
#MISE dir="{{env.APP_DIR}}"
#MISE quiet=true
set -euo pipefail
aube doctor
aube store status
echo "free space: $(df -h "$HOME" | awk 'NR==2{print $4}')"
du -sh ~/.local/share/aube/store/v1 ~/.cache/aube/virtual-store/v1 node_modules 2>/dev/null || true
aube store prune --dry-run
