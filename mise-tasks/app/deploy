#!/usr/bin/env bash
#MISE description="Create the Cloudflare D1 database if it's missing (writing its ID into wrangler.jsonc), migrate it, deploy the Worker to {{env.WORKER_PROD_URL}}"
#MISE timeout="10m"
#MISE hide=true
#MISE dir="{{env.APP_DIR}}"
#MISE depends=["app:build"]
set -euo pipefail
db_id() { aube exec wrangler d1 list --json 2>/dev/null | jq -r '.[] | select(.name == "d1-cube-check") | .uuid'; }
id=$(db_id)
if [ -z "$id" ]; then
  aube exec wrangler d1 create d1-cube-check > /dev/null
  id=$(db_id)
  echo "created D1 database d1-cube-check ($id)"
fi
sed -i '' -E "s/\"database_id\": \"[^\"]*\"/\"database_id\": \"$id\"/" wrangler.jsonc
CI=1 aube exec wrangler d1 migrations apply d1-cube-check --remote
aube exec wrangler deploy
echo "deployed: $WORKER_PROD_URL   test it: mise run app:test --prod"
