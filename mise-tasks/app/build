#!/usr/bin/env bash
#MISE description="Build the React UI (drizzle-cube's components) into ui/dist, which the Worker serves. Skips when nothing changed"
#MISE timeout="5m"
#MISE hide=true
#MISE dir="{{env.APP_DIR}}"
#MISE depends=["app:setup"]
#MISE sources=["ui/index.html", "ui/src/**/*", "vite.config.ts", "aube-lock.yaml"]
#MISE outputs=["ui/dist/index.html"]
set -euo pipefail
aube exec vite build
